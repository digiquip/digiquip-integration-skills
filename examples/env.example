# DigiQuip Registry M2M — copy to .env and fill in. Never commit .env.

# Logto M2M (from DigiQuip)
DIGIQUIP_CLIENT_ID=
DIGIQUIP_CLIENT_SECRET=

# Token endpoint — staging/test example:
# DIGIQUIP_TOKEN_ENDPOINT=https://devlogin.digiquip.com/oidc/token
# Production example:
# DIGIQUIP_TOKEN_ENDPOINT=https://login.digiquip.com/oidc/token
DIGIQUIP_TOKEN_ENDPOINT=

# OAuth resource / audience (exact string from onboarding; staging often uses http://)
# Staging / test:  http://test-registry.kvipp.io
# Production:      https://registry.kvipp.io
DIGIQUIP_TOKEN_RESOURCE=

# Registry API base URL (always HTTPS)
# Staging / test:  https://test-registry.kvipp.io
# Production:      https://registry.kvipp.io
DIGIQUIP_REGISTRY_URL=https://test-registry.kvipp.io

# Optional: comma-separated Registry organization UUIDs for local scripts
# (the JWT also carries allowed_organizations when using :own scopes)
# DIGIQUIP_ALLOWED_ORGANIZATION_IDS=
