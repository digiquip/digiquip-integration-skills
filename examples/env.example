# DigiQuip Registry M2M — copy to .env and fill in. Never commit .env.

# Logto M2M (from DigiQuip)
DIGIQUIP_CLIENT_ID=
DIGIQUIP_CLIENT_SECRET=

# OAuth resource / audience for token request (confirm in onboarding)
DIGIQUIP_TOKEN_RESOURCE=https://registry.kvipp.io

# Registry API base URL
# Test:    https://test-registry.kvipp.io
# Production: https://registry.kvipp.io
DIGIQUIP_REGISTRY_URL=https://test-registry.kvipp.io

# Optional: comma-separated Registry organization UUIDs for local scripts
# (the JWT also carries allowed_organizations when using :own scopes)
# DIGIQUIP_ALLOWED_ORGANIZATION_IDS=
